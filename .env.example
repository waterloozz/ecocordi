# ============================================================
#  ECOCORDI - Configuración (ejemplo, SIN valores reales)
#
#  Copia este archivo como ".env" y completa los valores:
#      cp .env.example .env
#  El servidor lee .env al arrancar. El .env NUNCA se sube a GitHub
#  (está en .gitignore). Una línea vacía o comentada = no configurado.
# ============================================================

# --- Cuenta de administrador ---
# Clave del admin (si la defines, reemplaza la actual cada vez que arranca)
ADMIN_CLAVE=
# ADMIN_CORREO=admin@ecocordi.cl

# --- Iniciar sesión con Google (Google Cloud Console → Credenciales) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Solo en producción (debe ser igual a la URI registrada en Google Cloud):
# GOOGLE_REDIRECT_URI=https://tu-dominio.cl/api/auth/google/callback

# --- Sitio público ---
# Dirección del sitio, sin "/" al final. Se usa en sitemap.xml, robots.txt,
# las vistas previas al compartir en redes y (si no defines otra) la vuelta
# del inicio de sesión con Google.
# SITIO_URL=https://www.ecocordi.cl
SITIO_URL=

# --- WhatsApp ---
# Número con código de país, solo dígitos (ej: 56912345678).
# Vacío = el botón de WhatsApp no aparece.
WHATSAPP_NUMERO=

# --- Producción con HTTPS: la cookie de sesión solo viaja cifrada ---
# COOKIE_SEGURA=1

# --- Servidor (normalmente no hace falta cambiarlos) ---
# PUERTO=8000
# ECOCORDI_DB=/ruta/a/ecocordi.db
